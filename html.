<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TechBlog</title>

<style>
:root{
    --bg:#0f172a;
    --card:#1e293b;
    --primary:#2563eb;
    --text:#ffffff;
    --text-soft:#cbd5e1;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Segoe UI, Arial, sans-serif;
    background:var(--bg);
    color:var(--text);
}

header{
    background:linear-gradient(135deg,#2563eb,#7c3aed);
    text-align:center;
    padding:70px 20px;
}

header h1{
    font-size:3rem;
    margin-bottom:10px;
}

header p{
    opacity:.9;
}

nav{
    background:#111827;
    padding:15px;
    text-align:center;
}

nav a{
    color:white;
    text-decoration:none;
    margin:0 15px;
    font-weight:600;
}

nav a:hover{
    color:#60a5fa;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:40px 20px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
    gap:25px;
}

.card{
    background:var(--card);
    border-radius:15px;
    overflow:hidden;
    transition:0.3s;
}

.card:hover{
    transform:translateY(-6px);
}

.card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.card-content{
    padding:20px;
}

.card h2{
    margin-bottom:10px;
}

.card p{
    color:var(--text-soft);
    margin-bottom:15px;
}

.btn{
    display:inline-block;
    background:var(--primary);
    color:white;
    text-decoration:none;
    padding:10px 18px;
    border-radius:8px;
}

.btn:hover{
    background:#1d4ed8;
}

footer{
    background:#111827;
    text-align:center;
    padding:25px;
    margin-top:40px;
}

#contador{
    margin-top:15px;
    font-size:14px;
}
</style>
</head>
<body>

<header>
    <h1>TechBlog</h1>
    <p>Tecnologia • Programação • Inteligência Artificial</p>
    <div id="contador"></div>
</header>

<nav>
    <a href="#artigos">Artigos</a>
    <a href="#sobre">Sobre</a>
    <a href="#contato">Contato</a>
</nav>

<main class="container">

<section id="artigos">
    <div class="grid">

        <article class="card">
            <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800"
                 alt="Inteligência Artificial">

            <div class="card-content">
                <h2>Inteligência Artificial</h2>
                <p>As principais tendências e aplicações de IA para os próximos anos.</p>
                <a class="btn" href="#">Ler artigo</a>
            </div>
        </article>

        <article class="card">
            <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=800"
                 alt="Programação Web">

            <div class="card-content">
                <h2>Desenvolvimento Web</h2>
                <p>Aprenda HTML, CSS e JavaScript criando projetos reais.</p>
                <a class="btn" href="#">Ler artigo</a>
            </div>
        </article>

        <article class="card">
            <img src="https://images.unsplash.com/photo-1556075798-4825dfaaf498?w=800"
                 alt="GitHub">

            <div class="card-content">
                <h2>GitHub Pages</h2>
                <p>Publique seu portfólio ou blog gratuitamente em poucos minutos.</p>
                <a class="btn" href="#">Ler artigo</a>
            </div>
        </article>

    </div>
</section>

<section id="sobre" style="margin-top:60px;">
    <h2>Sobre</h2>
    <p style="margin-top:15px;color:#cbd5e1;">
        Blog focado em tecnologia, programação, desenvolvimento web
        e inteligência artificial.
    </p>
</section>

<section id="contato" style="margin-top:60px;">
    <h2>Contato</h2>

    <form style="margin-top:20px;">
        <input
            type="text"
            placeholder="Seu nome"
            style="width:100%;padding:12px;margin-bottom:10px;border-radius:8px;border:none;">

        <input
            type="email"
            placeholder="Seu e-mail"
            style="width:100%;padding:12px;margin-bottom:10px;border-radius:8px;border:none;">

        <textarea
            rows="5"
            placeholder="Sua mensagem"
            style="width:100%;padding:12px;border-radius:8px;border:none;"></textarea>

        <button
            type="submit"
            style="margin-top:15px;padding:12px 20px;border:none;background:#2563eb;color:white;border-radius:8px;cursor:pointer;">
            Enviar
        </button>
    </form>
</section>

</main>

<footer>
    <p>© 2026 TechBlog</p>
</footer>

<script>
const hoje = new Date();

document.getElementById("contador").innerHTML =
"📅 Última atualização: " +
hoje.toLocaleDateString("pt-BR");
</script>

</body>
</html>
